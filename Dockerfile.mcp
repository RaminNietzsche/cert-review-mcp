# MCP server image: the same pinned-major toolchain as ./Dockerfile (which stays
# the GitHub Action image), with `cert-review-mcp` (stdio) as the entrypoint.
# Semgrep (with the bundled CERT rules) is included for amd64 and arm64. Infer
# (about 1.2 GB unpacked, no Linux arm64 release) and CodeQL (separate licence)
# are not; docs/analyzers.md shows how to add them in a derived image.
#
#   docker build -f Dockerfile.mcp -t cert-review-mcp .
#   docker run -i --rm -v "$PWD:$PWD" cert-review-mcp                 # MCP over stdio
#   docker run --rm -v "$PWD:$PWD" -w "$PWD" --entrypoint cert-review \
#     cert-review-mcp check src --format markdown                     # CLI
#
# Mount the project at the same absolute path as on the host, so paths that a
# client passes to the tools resolve inside the container.
FROM debian:trixie-slim

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      git ca-certificates python3 python3-venv python3-pip \
      clang-19 clang-tidy-19 cppcheck libc6-dev libstdc++-14-dev \
 && ln -s /usr/bin/clang-19 /usr/local/bin/clang && ln -s /usr/bin/clang++-19 /usr/local/bin/clang++ \
 && ln -s /usr/bin/clang-tidy-19 /usr/local/bin/clang-tidy \
 && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md LICENSE NOTICE /opt/cert-review/
COPY src /opt/cert-review/src
COPY data /opt/cert-review/data
COPY profiles /opt/cert-review/profiles
RUN python3 -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir /opt/cert-review semgrep==1.186.0 \
 && git config --system --add safe.directory '*'

ENV CERT_REVIEW_HOME=/opt/cert-review PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1
LABEL org.opencontainers.image.title="cert-review-mcp" \
      org.opencontainers.image.description="SEI CERT C/C++ review MCP server (stdio) and CLI with clang-tidy, Clang Static Analyzer, cppcheck and Semgrep" \
      org.opencontainers.image.source="https://github.com/RaminNietzsche/cert-review-mcp" \
      org.opencontainers.image.licenses="Apache-2.0" \
      io.modelcontextprotocol.server.name="io.github.RaminNietzsche/cert-review-mcp"
WORKDIR /workspace
ENTRYPOINT ["cert-review-mcp"]
